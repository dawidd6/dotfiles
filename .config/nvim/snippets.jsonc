// VSCode snippet format, one file for all languages.
// "scope": comma-separated filetypes; omit it for a global snippet.
{
	"date": {
		"prefix": "date",
		"body": "$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
	},
	"require": {
		"scope": "lua",
		"prefix": "req",
		"body": "local ${1:name} = require(\"${1}\")",
	},
	"if err": {
		"scope": "go",
		"prefix": "iferr",
		"body": ["if err != nil {", "\treturn ${1:err}", "}"],
	},
}
