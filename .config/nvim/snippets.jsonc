// VSCode snippet format, one file for all languages.
// "scope": comma-separated filetypes; omit it for a global snippet.
{
	"shebang": {
		"prefix": "shebang",
		"body": "#!/usr/bin/env ${1:bash}",
	},
	"iferr": {
		"scope": "go",
		"prefix": "iferr",
		"body": ["if err != nil {", "\treturn ${1:err}", "}"],
	},
}
