color cursor default blue bold
color cursor-blur default blue

set main-view-date-display = relative
set diff-highlight = true

bind main P >sh -c 'git show --color %(commit) | diff-so-fancy | less --tabs 4 -R'
bind diff <Up> move-up
bind diff <Down> move-down
bind stage <Up> move-up
bind stage <Down> move-down
bind tree <Backspace> parent
