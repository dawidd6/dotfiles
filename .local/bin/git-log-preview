#!/usr/bin/env bash

set -euo pipefail

git log --color "$@" |
	fzf \
		--ansi \
		--no-sort \
		--multi \
		--print0 \
		--accept-nth 1 \
		--header 'Tab - select commits, Enter - copy commits, Space - show commit' \
		--bind 'space:execute(git show --color {+1} | diff-so-fancy | less --tabs 4 -R)' \
		--preview 'git show --color {1} | diff-so-fancy' \
		--preview-window 'right:60%:wrap' |
	tr '\0' ' ' | wl-copy -n
