#!/usr/bin/env bash

set -euo pipefail

if ! branch="$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')"; then
    for branch in master main; do
        if git rev-parse --quiet --verify "$branch" &>/dev/null; then
            break
        fi
    done
fi

if [[ -z "$branch" ]]; then
    echo 'No main branch found!'
    exit 1
else
    git checkout "$branch"
fi
